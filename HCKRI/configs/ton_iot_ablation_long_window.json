{
  "data": {
    "data_dir": "data/raw/TON_IoT",
    "file_glob": "*.csv",
    "auto_download": true,
    "download_url": "https://huggingface.co/datasets/codymlewis/TON_IoT_network/resolve/main/train_test_network.csv?download=true",
    "download_filename": "train_test_network.csv",
    "download_sha256": "26ddc513552de36de6428b2e578efaed2b57504c716dfba847cc0109a64e1974",
    "download_timeout": 120,
    "max_rows_per_file": 20000,
    "sequence_length": 24,
    "stride": 6,
    "val_size": 0.15,
    "test_size": 0.2,
    "labeled_fraction": 0.3,
    "numeric_hash_dim": 48,
    "categorical_hash_dim": 32,
    "allow_synthetic_fallback": false,
    "synthetic_samples": 2500,
    "seed": 42,
    "risk_level_names": ["normal", "low risk", "medium risk", "high risk", "critical risk"],
    "risk_type_level_map": {
      "normal": 0,
      "scanning": 1,
      "scan": 1,
      "password": 2,
      "xss": 2,
      "injection": 3,
      "dos": 3,
      "ddos": 3,
      "backdoor": 4,
      "mitm": 4,
      "ransomware": 4,
      "malware": 4,
      "data_exfiltration": 4
    },
    "unknown_attack_types": ["mitm", "ransomware"]
  },
  "model": {
    "model_dim": 64,
    "source_embedding_dim": 16,
    "cnn_kernel_sizes": [3, 5, 7],
    "lstm_hidden": 64,
    "transformer_layers": 2,
    "transformer_heads": 4,
    "dropout": 0.2
  },
  "train": {
    "epochs": 8,
    "batch_size": 64,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "semi_supervised_weight": 0.35,
    "contrastive_weight": 0.1,
    "pseudo_label_threshold": 0.9,
    "prototype_temperature": 0.2,
    "anomaly_threshold": 0.5,
    "unknown_confidence_threshold": 0.55,
    "device": "auto",
    "seed": 42
  },
  "output": {
    "results_path": "outputs/ton_iot_ablation_long_window_results.json"
  }
}
